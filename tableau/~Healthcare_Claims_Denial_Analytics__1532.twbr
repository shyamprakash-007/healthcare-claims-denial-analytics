        <zone h='8500' id='1' type-v2='text' w='100000' x='0' y='0'>
          <formatted-text>
            <run fontcolor='#b0deea' fontname='Arial' fontsize='10'>HEALTHCARE CLAIMS  /  SYNTHETIC PORTFOLIO
</run>
            <run bold='true' fontcolor='#ffffff' fontname='Arial' fontsize='23'>Executive Overview</run>
