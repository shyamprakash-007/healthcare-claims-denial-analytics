            <encodings>
              <text column='[textscan.claims].[usr:Total claims:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run><![CDATA[Distinct Claim IDs in the selected population.
Total claims: <[textscan.claims].[usr:Total claims:qk]>
Synthetic claims. Amounts in source currency units.]]></run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='mark-color' value='#197c90' />
                <format attr='mark-labels-show' value='true' />
                <format attr='font-size' value='24' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
