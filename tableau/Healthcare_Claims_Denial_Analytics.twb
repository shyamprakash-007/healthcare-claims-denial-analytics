            </column>
            <column name="[Under review]" caption="Under Review" datatype="real" role="measure" type="quantitative" default-format="n#,##0">
              <calculation class="tableau" formula="COUNTD(IF [claim_status]=&quot;Under Review&quot; THEN [claim_id] END)" />
            </column>
            <column name="[Denial rate]" caption="Denial Rate" datatype="real" role="measure" type="quantitative" default-format="p0.0%">
